# Shared runtime
MLFLOW_TRACKING_URI=http://127.0.0.1:8080
DEVICE=auto

# Shot classification model
SHOT_CLASSIFICATION_MODEL_URI=models:/TennisVision@champion
SHOT_CLASSIFICATION_RUN_ID=
SHOT_CLASSIFICATION_MODEL_NAME=mobilenet_v3_large

# Image detection model
DETECTION_MODEL_URI=
DETECTION_RUN_ID=
DETECTION_MODEL_ARTIFACT_PATH=weights/best.pt
DETECTION_MODEL_PATH=data/artifacts/detection/yolo11n_baseline/weights/best.pt

# Video detection model
VIDEO_DETECTION_MODEL_URI=
VIDEO_DETECTION_RUN_ID=
VIDEO_DETECTION_MODEL_ARTIFACT_PATH=weights/best.pt
VIDEO_DETECTION_MODEL_PATH=data/artifacts/detection/yolo11s_baseline/weights/best.pt

# Runtime output
VIDEO_DETECTION_RESULTS_DIR=data/artifacts/video_detection/api_results
VIDEO_POSTPROCESSING_CONFIG_PATH=src/tennisvision/tasks/video_detection/configs/postprocessing/baseline_v1.yaml
VIDEO_DETECTION_DEFAULT_MAX_PLAYERS=2

# Optional runtime overrides
VIDEO_DETECTION_IMGSZ=1280
VIDEO_DETECTION_CONFIDENCE=0.5
VIDEO_DETECTION_IOU=0.7
